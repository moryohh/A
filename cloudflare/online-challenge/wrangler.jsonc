{
  "name": "duha-online-challenge",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ChallengeRoom" },
      { "name": "REGISTRY", "class_name": "ChallengeRegistry" },
      { "name": "REGISTRY_V2", "class_name": "ChallengeRegistryV2" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChallengeRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ChallengeRegistry"] },
    { "tag": "v3", "new_sqlite_classes": ["ChallengeRegistryV2"] }
  ],
  "vars": {
    "SUPABASE_URL": "https://qlfleszoyujelygwzdgu.supabase.co",
    "ALLOWED_ORIGINS": "https://a-1q1.pages.dev,https://duha-challenge-preview.pages.dev,https://preview-online-challenge.duha-challenge-preview.pages.dev",
    "ALLOW_PREVIEW_GUESTS": "true",
    "PREVIEW_GUEST_ORIGINS": "https://duha-challenge-preview.pages.dev,https://preview-online-challenge.duha-challenge-preview.pages.dev",
    "TEAM_MATCHMAKING_WAIT_MS": "5000"
  }
}
